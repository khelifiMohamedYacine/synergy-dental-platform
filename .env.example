# Copy to .env and replace every CHANGE_ME value. .env is git-ignored.
# Generate secrets with:  py -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- PostgreSQL (business data) ----------
POSTGRES_DB=synergy
POSTGRES_USER=synergy
POSTGRES_PASSWORD=CHANGE_ME

# ---------- FastAPI ----------
API_ENV=development
DATABASE_URL=postgresql+psycopg://synergy:CHANGE_ME@postgres:5432/synergy
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Shared secret the WordPress plugin sends in X-Service-Key
SERVICE_API_KEY=CHANGE_ME
ENQUIRY_RATE_LIMIT=5/minute
# Initial admin created by the seed script (fictional account)
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=CHANGE_ME
# Password for the demo STAFF accounts (staff@ / manager@example.test)
SEED_STAFF_PASSWORD=CHANGE_ME

# ---------- WooCommerce REST (read-only keys created by provisioning) ----------
WC_BASE_URL=http://wordpress
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ---------- MariaDB (WordPress) ----------
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=CHANGE_ME
WP_DB_ROOT_PASSWORD=CHANGE_ME

# ---------- WordPress ----------
WP_URL=http://localhost:8080
WP_ADMIN_USER=sd_site_owner
WP_ADMIN_PASSWORD=CHANGE_ME
WP_ADMIN_EMAIL=owner@example.test
# FastAPI base URL as seen from inside the Docker network
SYNERGY_API_URL=http://api:8000/api/v1
